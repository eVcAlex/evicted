UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Despite the name, this is a passphrase, not a 4-digit PIN. The admin endpoint
# is on a public site and is not rate limited, so anything short is guessable.
# Minimum 16 characters, and `checkPin` refuses every write below that.
# Generate one with: openssl rand -base64 24
ADMIN_PIN=

# Monzo OAuth client — developers.monzo.com > Clients > New OAuth Client.
# Confidentiality: Confidential. Redirect URL must exactly match
# <site>/api/monzo/callback for both production and localhost.
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=

# Base URL this deployment is reachable at, used to build the OAuth redirect
# URI and to register the webhook with Monzo. No trailing slash.
MONZO_REDIRECT_BASE_URL=
